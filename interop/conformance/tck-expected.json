  "tck": {
    "repository": "https://github.com/a2aproject/a2a-tck",
    "commit": "263b9cfaf16a554bdfb166a7ba5b67716e946349",
    "commit_date": "2026-09-01",
    "package_version": "1.0.0",
    "spec": "A2A v1.0.0 (a2aproject/A2A@173695755607e884aa9acf8ce4feed90e32727a1, vendored by the TCK)",
    "note": "Newest tag is 1.0.0.alpha2 (2026-05-27, no GitHub release); it predates a2a-tck PR #230 (follow redirects), so its JSON-RPC client cannot reach a non-root JSON-RPC endpoint. main is pinned instead."
  },
  "server": "python -m agent_movement.a2a_server (a2a-sdk[http-server]==1.2.2)",
  "deviations": {
    "D1-required-extension": "The handoff profile is a required extension (A2A v1.0 sec. 3.3.4, 4.6.1); the TCK harness at this commit does not send A2A-Extensions for required card extensions (a2a-tck PR #197, open), so every positive-path message is answered with ExtensionSupportRequiredError (-32008 / HTTP 400).",
    "D2-profile-only-messages": "Even with the extension activated (verified with a2a-tck PR #197 applied), the TCK's plain-text or TCK-scenario messages are not handoff messages and are refused with InvalidParamsError (-32602) before any task exists, by design of the profile (docs/a2a-profile-extension.md sec. 4). Tests that need a TCK-created task are therefore SKIPPED.",
    "D3-content-type-mapping": "Expects ContentTypeNotSupportedError for a wrong HTTP Content-Type header (and HTTP 415). a2a-sdk 1.2.2 does not check the request Content-Type header and maps ContentTypeNotSupportedError to HTTP 400, not the 415 of the A2A v1.0 sec. 5.4 table; under this server the request is refused first by D1. Upstream SDK behaviour, not changed here.",
    "D4-tck-send-003": "CORE-SEND-003: the server returns the correct ContentTypeNotSupportedError (-32005, reason CONTENT_TYPE_NOT_SUPPORTED), but the TCK requirement at this commit declares no expected_error, so its validator counts any error response as a failure (TCK defect).",
    "D5-last-modified-may": "CARD-CACHE-003 is a MAY (sec. 8.6.1): no Last-Modified header; the card carries Cache-Control max-age and an ETag (304 on If-None-Match)."
  },
  "status_notes": {
    "SKIPPED": "Skipped by the TCK: no gRPC interface, push notifications and the extended card are not declared, or the test needs a task created from a TCK message (D1, D2).",
    "NOT TESTED": "Recorded by no test in this run: the TCK has no automated test for the requirement at this commit (authentication, TLS, card signing, binding equivalence, versioning), or the test that records it first needs a successful send from a TCK message (D1, D2)."
  },
